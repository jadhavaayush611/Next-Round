# Project Settings
PROJECT_NAME="NextRound API"
API_V1_STR="/api/v1"
ENVIRONMENT=development  # development, production, testing

# CORS Settings (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nextround_user
POSTGRES_PASSWORD=nextround_password
POSTGRES_DB=nextround_db
# If set, DATABASE_URL will override individual postgres parameters
DATABASE_URL=postgresql+psycopg://nextround_user:nextround_password@localhost:5432/nextround_db

# Security Settings
# Generate secret key using: openssl rand -hex 32
JWT_SECRET=88af2db432a13b6329ad4f828a2a8909477b73cdb6c31bf094a4c519280d5d1c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
